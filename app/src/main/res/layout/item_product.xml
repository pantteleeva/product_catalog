<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="#FFFFFF"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/productThumbnail"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="#E9ECF2"
        android:contentDescription="Фото товара"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/productName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название товара"
            android:textColor="#202638"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/productDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Категория • Остаток"
            android:textColor="#626B7A"
            android:textSize="13sp"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/productStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Активна"
            android:textColor="#27734A"
            android:textSize="13sp"
            android:paddingTop="4dp" />
    </LinearLayout>
</LinearLayout>
